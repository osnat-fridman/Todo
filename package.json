{
  "name": "shared-todo-list",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "vercel dev --listen 3000",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test",
    "db:push": "node scripts/db-push.mjs",
    "db:seed": "node scripts/db-seed.mjs",
    "postinstall": "node scripts/install-browser.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vercel/node": "^27.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "supabase": "^2.122.0",
    "typescript": "^6.0.3",
    "vercel": "^65.2.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.27.0": true
  }
}
