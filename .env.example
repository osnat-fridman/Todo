# Development (Supabase Dev project) only. Never put Production values here.

# app_backend user via the Supabase Transaction Pooler (port 6543), without "sslmode":
# postgresql://app_backend.<project-ref>:<app_backend-password>@<pooler-host>:6543/postgres
DATABASE_URL=

# Password of the "postgres" user of the Dev project. Used only by the Supabase CLI to apply migrations.
SUPABASE_DB_PASSWORD=
